// github.com/era-lang-official/random
// 64-bit Pseudo-Random Number Generator (PRNG) and sampling engine

fn rand_str_slice(s: string, start: usize, end: usize) -> string {
    let s_chars: Vec<char> = s.chars();
    let mut sb = StringBuilder::new();
    let mut i = start;
    let limit = if end > s_chars.len() { s_chars.len() } else { end };
    while i < limit {
        sb.append(s_chars[i].to_string());
        i += 1;
    }
    return sb.to_string();
}

pub struct Rng {
    pub state: i64,
}

impl Rng {
    pub fn seeded(seed: i64) -> Rng {
        let mut initial = seed;
        if initial == 0 {
            initial = 88172645463325252;
        }
        return Rng { state: initial };
    }

    pub fn from_entropy() -> Rng {
        let t = std::time::now();
        
        let mixed = t ^ 2862933555777941757;
        return Rng::seeded(mixed);
    }

    pub fn next_u64(&mut self) -> i64 {
        // 64-bit Xorshift* PRNG
        let mut x = self.state;
        x = x ^ (x >> 12);
        x = x ^ (x << 25);
        x = x ^ (x >> 27);
        self.state = x;
        let mult: i64 = 2685821657736338717;
        let mut res = x * mult;
        if res < 0 {
            res = -res;
        }
        return res;
    }

    pub fn next_int_range(&mut self, min: i64, max: i64) -> i64 {
        if max <= min {
            return min;
        }
        let diff = (max - min) + 1;
        let rand_val = self.next_u64();
        return min + (rand_val % diff);
    }

    pub fn next_string(&mut self, len: usize) -> string {
        let charset = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
        let mut sb = StringBuilder::new();
        let mut i: usize = 0;
        while i < len {
            let idx = (self.next_int_range(0, 61)) as usize;
            sb.append(rand_str_slice(charset.to_string(), idx, idx + 1));
            i += 1;
        }
        return sb.to_string();
    }

    pub fn shuffle_strings(&mut self, list: Vec<string>) {
        if list.len() <= 1 {
            return;
        }
        let mut i = list.len() - 1;
        while i > 0 {
            let j = (self.next_int_range(0, i as i64)) as usize;
            // Swap i and j
            let tmp = list[i].clone();
            list[i] = list[j].clone();
            list[j] = tmp;
            i -= 1;
        }
    }
}
